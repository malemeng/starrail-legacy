[gd_scene format=3]

[node name="SidePanel" type="PanelContainer"]
custom_minimum_size = Vector2(508, 0)

[node name="Column" type="VBoxContainer" parent="."]
theme_override_constants/separation = 10

[node name="Tabs" type="HBoxContainer" parent="Column"]
theme_override_constants/separation = 4

[node name="Scroll" type="ScrollContainer" parent="Column"]
size_flags_vertical = 3

[node name="Body" type="VBoxContainer" parent="Column/Scroll"]
size_flags_horizontal = 3
theme_override_constants/separation = 10
